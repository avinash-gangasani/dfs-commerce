@page "/"
@rendermode InteractiveServer
@using Models;
@using Newtonsoft.Json;
@using DFS_Commerce.Services;
@inject IProductService productService;

@* --- HTML Layout Section --- *@
<div class="dfs-commerce-container">

    <header class="header-section">
        <h1>DFS-Commerce</h1>
    </header>

    @* Filter Card *@
    <section class="filter-card">
        <div class="filter-group">
            <label>Price Range:</label>

            <div class="input-wrapper">
                <span>$</span>
                <input type="number" class="price-input" placeholder="Min" @bind="minValue" />
            </div>

            <span>to</span>

            <div class="input-wrapper">
                <span>$</span>
                <input type="number" class="price-input" placeholder="Max" @bind="maxValue" />
            </div>

            <button class="btn-search" @onclick="FilterProducts">Apply Filter</button>
        </div>
        <p class="helper-text">NOTE: Enter a range between $100 and $1000.</p>
    </section>

    @* Conditional Status Messages *@
    @if (isError)
    {
        <div class="status-msg status-error">
            ⚠️ <strong>Invalid Range:</strong> Please ensure the minimum price is less than or equal to the maximum price.
        </div>
    }

    @if (productsLoading ?? true && !isError)
    {
        <div class="status-msg status-loading">
            🔄 Querying our in-memory index... Please wait while we fetch your products.
        </div>
    }

    @if (products.Count() == 0 && !isError)
    {
        <div class="status-msg status-info">
            👋 Enter a price range above to discover curated items tailored to your budget.
        </div>
    }

    @* Product Grid & Pagination *@
    @if (products.Count() > 0)
    {
        <div class="product-grid">
            @foreach (var product in productsPerPage)
            {
                <div class="product-card">
                    <div>
                        <div class="product-name">@product.Name</div>
                        <div class="product-desc">@product.Description</div>
                    </div>
                    <div class="product-price">$@product.Price.ToString("F2")</div>
                </div>
            }
        </div>

        <div class="product-count-bar">
            <span class="count-text">
                Showing <strong>@productsPerPage.Count()</strong> of <strong>@products.Count()</strong> items matching your budget
            </span>
        </div>

        <nav class="pagination-container" aria-label="Product pagination">
            <span>Page</span>
            <input type="number" class="page-input" @bind="currentPage" min="1" max="@pages" />
            <button class="btn-page" @onclick="() => PaginateProducts(currentPage)">Go</button>
            <span>of @pages pages</span>
        </nav>
    }
    else if (products.Count() == 0
                && !isError
                && productsLoading == false
                && filterApplied == true)
    {
        <div class="status-msg status-error">
            🔍 We couldn't find any products within that specific price bracket. Try broadening your range!
        </div>
    }
</div>

@code {
    private double minValue = 100;
    private double maxValue = 10000;
    private bool? filterApplied;

    BinarySearchTree binarySearchTree = new BinarySearchTree();

    List<Product> products = new List<Product>();
    List<Product> productsPerPage = new List<Product>();

    private bool isError = false;
    private bool? productsLoading;
    private int pages = 1;
    private int currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        productsLoading = true;
        await LoadProductsIntoBST();
        productsLoading = false;
    }

    private void FilterProducts()
    {
        filterApplied = true;
        productsLoading = true;
        if ((minValue > maxValue) || (minValue < 100 || maxValue > 10000))
        {
            isError = true;
            return;
        }

        isError = false;
        products = binarySearchTree.Filter(minValue, maxValue);
        PaginateProducts(1);
        productsLoading = false;
    }

    private void PaginateProducts(int _currentCount)
    {
        if (_currentCount < 1) _currentCount = 1;
        if (_currentCount > pages) _currentCount = pages;

        currentPage = _currentCount;
        pages = (int)Math.Ceiling((double)products.Count() / 10);
        productsPerPage = products.Skip((_currentCount - 1) * 10).Take(10).ToList();
    }

    private async Task LoadProductsIntoBST()
    {
        var products = await productService.GetProducts("products_1000.json");

        foreach (var product in products)
        {
            binarySearchTree.Insert(product);
        }
    }
}
